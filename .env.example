# Forge V2 — Environment Variable Template
#
# Every variable below is validated by `packages/config/src/index.ts` (`configSchema`).
# All values shown are the schema defaults; copy this file to `.env` and override as needed.
# `.env` is gitignored. Never commit real credentials or production endpoints.

# Application Environment (development | production | test)
NODE_ENV=development

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# API Service Configuration (integer, 1-65535)
API_PORT=3000

# PostgreSQL Database Configuration (dev credentials only — must never reach production)
DATABASE_URL=postgresql://forge:forge@127.0.0.1:5432/forge

# Redis Transient Coordination Configuration
REDIS_URL=redis://127.0.0.1:6379

# Worker Heartbeat Configuration
# WORKER_HEARTBEAT_INTERVAL_MS: min 100. WORKER_HEARTBEAT_TTL_SECONDS: min 1.
# Constraint: WORKER_HEARTBEAT_TTL_SECONDS (x1000) must exceed WORKER_HEARTBEAT_INTERVAL_MS.
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_SECONDS=15

# Worker Job Lease Configuration
# WORKER_JOB_LEASE_DURATION_MS: min 1000. WORKER_JOB_LEASE_RENEWAL_INTERVAL_MS: min 500.
# Constraint: WORKER_JOB_LEASE_DURATION_MS must exceed WORKER_JOB_LEASE_RENEWAL_INTERVAL_MS.
WORKER_JOB_LEASE_DURATION_MS=30000
WORKER_JOB_LEASE_RENEWAL_INTERVAL_MS=10000

# Container Executor Configuration
# DEFAULT_EXECUTION_TIMEOUT_MS / MAX_EXECUTION_TIMEOUT_MS: min 1000.
# Constraint: MAX_EXECUTION_TIMEOUT_MS must be >= DEFAULT_EXECUTION_TIMEOUT_MS.
# MAX_OUTPUT_BYTES: min 1024 (bounded stdout/stderr capture).
DEFAULT_DOCKER_IMAGE=alpine:3.19
DEFAULT_EXECUTION_TIMEOUT_MS=60000
MAX_EXECUTION_TIMEOUT_MS=1800000
MAX_OUTPUT_BYTES=1048576
# DOCKER_HOST is optional and has no default; leave unset to use the local Docker daemon.
# Example (dev, unauthenticated — do not use outside a local box): tcp://127.0.0.1:2375
# DOCKER_HOST=

# Retry & Backoff Configuration
# DEFAULT_MAX_ATTEMPTS: min 1. MAX_JOB_ATTEMPTS: 1-100 (hard ceiling).
# Constraint: MAX_JOB_ATTEMPTS must be >= DEFAULT_MAX_ATTEMPTS.
# DEFAULT_RETRY_BASE_DELAY_MS: min 100. MAX_RETRY_BACKOFF_MS: min 1000.
# Constraint: MAX_RETRY_BACKOFF_MS must be >= DEFAULT_RETRY_BASE_DELAY_MS.
DEFAULT_MAX_ATTEMPTS=1
MAX_JOB_ATTEMPTS=10
DEFAULT_RETRY_BASE_DELAY_MS=1000
MAX_RETRY_BACKOFF_MS=3600000

# Fairness & Queue Aging Configuration
# FAIRNESS_AGING_INTERVAL_MS: min 1000. FAIRNESS_AGE_BONUS_STEP: min 1.
# FAIRNESS_MAX_AGE_BONUS: 0-2000 (hard ceiling).
# Constraint: FAIRNESS_MAX_AGE_BONUS must be >= FAIRNESS_AGE_BONUS_STEP.
FAIRNESS_AGING_INTERVAL_MS=60000
FAIRNESS_AGE_BONUS_STEP=10
FAIRNESS_MAX_AGE_BONUS=500

# --- Outbox dispatcher (PR 21) ---
# OUTBOX_DISPATCH_POLL_INTERVAL_MS: min 100. OUTBOX_DISPATCH_BATCH_SIZE: 1-1000.
# OUTBOX_CLAIM_TIMEOUT_MS: min 1000. OUTBOX_PUBLISH_TIMEOUT_MS: min 500.
# Constraint: OUTBOX_CLAIM_TIMEOUT_MS must be >= OUTBOX_PUBLISH_TIMEOUT_MS + OUTBOX_DISPATCH_POLL_INTERVAL_MS.
# OUTBOX_MAX_DELIVERY_ATTEMPTS: 1-100 (genuine transport rejections before a row is marked DEAD).
# OUTBOX_DELIVERY_BASE_BACKOFF_MS: min 50. OUTBOX_DELIVERY_MAX_BACKOFF_MS: min 1000.
# Constraint: OUTBOX_DELIVERY_MAX_BACKOFF_MS must be >= OUTBOX_DELIVERY_BASE_BACKOFF_MS.
# OUTBOX_MAX_PAYLOAD_BYTES: min 1024 (enqueue is rejected above this).
# OUTBOX_RETENTION_MAX_AGE_MS: min 0 (default 604800000 = 7 days; 0 disables retention). Only PUBLISHED rows are deleted.
# OUTBOX_RETENTION_BATCH_SIZE: min 1. OUTBOX_RETENTION_EVERY_N_TICKS: min 1.
OUTBOX_DISPATCH_POLL_INTERVAL_MS=1000
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_CLAIM_TIMEOUT_MS=60000
OUTBOX_PUBLISH_TIMEOUT_MS=10000
OUTBOX_MAX_DELIVERY_ATTEMPTS=10
OUTBOX_DELIVERY_BASE_BACKOFF_MS=500
OUTBOX_DELIVERY_MAX_BACKOFF_MS=60000
OUTBOX_MAX_PAYLOAD_BYTES=65536
OUTBOX_RETENTION_MAX_AGE_MS=604800000
OUTBOX_RETENTION_BATCH_SIZE=500
OUTBOX_RETENTION_EVERY_N_TICKS=60
